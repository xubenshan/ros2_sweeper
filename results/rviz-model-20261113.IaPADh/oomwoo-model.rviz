Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Value: true
    Cell Size: 0.1
    Plane Cell Count: 12
    Color: 100; 112; 128
    Alpha: 0.35
  - Alpha: 1.0
    Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Value: /robot_description
    Enabled: true
    Name: RobotModel
    Value: true
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/TF
    Name: TF
    Value: false
    Enabled: false
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 30
    Background Color: 40; 47; 57
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.65
      Name: Current View
      Pitch: 0.57
      Value: Orbit (rviz)
      Yaw: 0.66
      Focal Point:
        X: 0
        Y: 0
        Z: 0.055
Window Geometry:
  Height: 725
  Width: 1024

<robot name="oomwoo_one">
  <!-- ****************** **************** ****************** -->
  <!-- = body cylinder center, base_link frame -->
  <!-- total beam FOV (deg) -->
  <!-- kg, negligible -->
  <!-- kg, negligible -->
  <!-- kg, negligible -->
  <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.235</wheel_separation>
      <wheel_radius>0.034</wheel_radius>
      <max_linear_acceleration>1</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <!-- Wheel-encoder odometry, always published. It owns /odom (+ /tf) only when
           selected; otherwise it goes to /odom_wheel for slip comparison and leaves
           /tf to the ground-truth publisher. -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <!-- Ground-truth (true model pose) odometry, always published. Owns /odom
           (+ /tf) when selected; otherwise /odom_truth, with its TF sent to an
           unbridged topic so the wheel odom owns /tf. -->
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
      <odom_topic>/odom_truth</odom_topic>
      <tf_topic>tf_truth</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- update_rate>30</update_rate -->
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
    <!-- The Contact system is a WORLD-level system in gz-sim; declaring it here
         at model level is a no-op (verified: contacts never fire in a world that
         lacks the world-level plugin, even though the sensor and topic exist).
         The world MUST load it:
           <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
         Both worlds OOMWOO ships already do (oomwoo_sim_support test_room.world and
         oomwoo_gazebo living_room.world). It is kept here as documentation of the
         dependency; remove it and nothing changes. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
  </gazebo>
  <!-- Front bumper contact sensors. Each half watches all of its arc-facet
       collisions on base_link (see robot.urdf.xacro) and publishes gz.msgs.Contacts.
       NOTE: gz-sim ignores the <topic> below for contact sensors and publishes only
       to the scoped name /world/<world>/model/<model>/link/base_footprint/sensor/
       <sensor>/contact, which config/gz_bridge.yaml bridges verbatim. -->
  <gazebo reference="base_link">
    <sensor name="bumper_left" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>base_footprint_fixed_joint_lump__bumper_left_0_collision_1</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_1_collision_2</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_2_collision_3</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_3_collision_4</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_4_collision_5</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_5_collision_6</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_6_collision_7</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_7_collision_8</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_8_collision_9</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_9_collision_10</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_10_collision_11</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_left_11_collision_12</collision>
      </contact>
      <topic>bumper_left/contact</topic>
    </sensor>
    <sensor name="bumper_right" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>base_footprint_fixed_joint_lump__bumper_right_0_collision_13</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_1_collision_14</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_2_collision_15</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_3_collision_16</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_4_collision_17</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_5_collision_18</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_6_collision_19</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_7_collision_20</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_8_collision_21</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_9_collision_22</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_10_collision_23</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_right_11_collision_24</collision>
      </contact>
      <topic>bumper_right/contact</topic>
    </sensor>
  </gazebo>
  <gazebo reference="base_scan">
    <sensor name="laser_scan_sensor" type="gpu_lidar">
      <!-- sensor type="ray" name="laser_scan_sensor" -->
      <pose relative_to="base_scan"> 0 0 0 0 0 0 </pose>
      <update_rate>5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.283185307179586</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="range_left" type="gpu_lidar">
      <!-- Pose baked relative to base_link (the canonical link, unaffected by
             fixed-joint lumping) so the ray aim does not depend on the lumped
             sensor-link frame orientation. Matches the ${prefix}_link URDF joint. -->
      <pose relative_to="base_link">0.0 0.1745 0.03325 0 0 1.5707970000000002</pose>
      <update_rate>20</update_rate>
      <topic>range_left</topic>
      <gz_frame_id>range_left_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.00872665</min_angle>
            <max_angle>0.00872665</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>0.5</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="range_right" type="gpu_lidar">
      <!-- Pose baked relative to base_link (the canonical link, unaffected by
             fixed-joint lumping) so the ray aim does not depend on the lumped
             sensor-link frame orientation. Matches the ${prefix}_link URDF joint. -->
      <pose relative_to="base_link">0.0 -0.1745 0.03325 0 0 -1.5707970000000002</pose>
      <update_rate>20</update_rate>
      <topic>range_right</topic>
      <gz_frame_id>range_right_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.00872665</min_angle>
            <max_angle>0.00872665</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>0.5</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="tof_front_link">
    <sensor name="tof_front" type="gpu_lidar">
      <pose relative_to="tof_front_link">0 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <topic>tof_front</topic>
      <gz_frame_id>tof_front_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-1.047198</min_angle>
            <max_angle>1.047198</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.523599</min_angle>
            <max_angle>0.523599</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <enable_orientation>true</enable_orientation>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

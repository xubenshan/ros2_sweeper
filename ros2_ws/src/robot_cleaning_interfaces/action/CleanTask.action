# Use an existing task_id with resume_checkpoint to resume after a node restart.
string task_id
uint8 ALL=0
uint8 REGIONS=1
uint8 mode
string[] regions
float32 target_coverage
bool resume_checkpoint
---
bool success
string reason
float32 coverage
float64 path_length_m
uint32 completed_waypoints
uint32 failed_waypoints
---
string state
float32 coverage
uint32 completed_waypoints
uint32 total_waypoints
geometry_msgs/PoseStamped current_goal

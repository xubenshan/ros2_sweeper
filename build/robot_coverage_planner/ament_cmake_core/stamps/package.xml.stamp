<?xml version="1.0"?>
<package format="3">
  <name>robot_coverage_planner</name>
  <version>0.1.0</version>
  <description>Grid coverage planning and map-frame coverage tracking.</description>
  <maintainer email="maintainers@example.com">Sweeper contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>robot_cleaning_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
